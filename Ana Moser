    } else if (imc < 40) {
      classificacao = "Obesidade Grau II";
    } else {
      classificacao = "Obesidade Grau III";
    }


    setResultado(
      `IMC: ${imc.toFixed(2)}\nClassificação: ${classificacao}`
    );
  }


  return (
