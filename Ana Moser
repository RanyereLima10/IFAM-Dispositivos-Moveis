      setResultado("Preencha todos os campos.");
      return;
    }


    const n1 = parseFloat(nota1);
    const n2 = parseFloat(nota2);


    if (isNaN(n1) || isNaN(n2)) {
      setResultado("Digite notas válidas.");
      return;
    }


    const media = (n1 + n2) / 2;


    let situacao = "";


    if (media >= 7) {
      situacao = "Aprovado";
    } else if (media >= 5) {
      situacao = "Recuperação";
    } else {
      situacao = "Reprovado";
    }


    setResultado(
      `Aluno: ${nome}\nMédia: ${media.toFixed(1)}\nSituação: ${situacao}`
    );
  }


  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Controle Escolar</Text>


      <TextInput
        style={styles.input}
        placeholder="Nome do aluno"
        value={nome}
        onChangeText={setNome}
      />


      <TextInput
        style={styles.input}
        placeholder="1ª Nota"
        keyboardType="numeric"
        value={nota1}
        onChangeText={setNota1}
      />


      <TextInput
        style={styles.input}
        placeholder="2ª Nota"
        keyboardType="numeric"
        value={nota2}
        onChangeText={setNota2}
      />


      <Button
        title="Calcular Média"
        onPress={calcularMedia}
      />


      <Text style={styles.resultado}>
        {resultado}
      </Text>
    </View>
  );
}


