    const deposito = parseFloat(valor);


    if (isNaN(deposito) || deposito <= 0) {
      Alert.alert("Erro", "Valor inválido.");
      return;
    }


    setSaldo(saldo + deposito);
    Alert.alert("Sucesso", `Depósito de R$ ${deposito.toFixed(2)} realizado.`);
    setValor("");
  }


  return (
