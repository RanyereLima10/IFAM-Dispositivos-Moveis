import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
} from 'react-native';

export default function App() {
  const [nome, setNome] = useState('');
  const [email, setEmail] = useState('');
  const [idade, setIdade] = useState('');
  const [mensagem, setMensagem] = useState('');
  const [corMensagem, setCorMensagem] = useState('red');

  const cadastrar = () => {
    // Verifica campos vazios
    if (!nome || !email || !idade) {
      setCorMensagem('red');
      setMensagem('Erro: Preencha todos os campos.');
      return;
    }

    // Validação do e-mail
    const regexEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!regexEmail.test(email)) {
      setCorMensagem('red');
      setMensagem('Erro: Digite um e-mail válido.');
      return;
    }

    // Validação da idade
    if (isNaN(idade) || Number(idade) <= 0) {
      setCorMensagem('red');
      setMensagem('Erro: Digite uma idade válida.');
      return;
    }

    // Mensagem de sucesso
    setCorMensagem('green');
    setMensagem(
      `Cadastro realizado com sucesso!\n\n` +
      `Nome: ${nome}\n` +
      `E-mail: ${email}\n` +
      `Idade: ${idade} anos`
    );

    // Limpa os campos
    setNome('');
    setEmail('');
    setIdade('');
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Cadastro de Participantes</Text>

      <TextInput
        style={styles.input}
        placeholder="Nome"
        value={nome}
        onChangeText={setNome}
      />

      <TextInput
        style={styles.input}
        placeholder="E-mail"
        keyboardType="email-address"
        autoCapitalize="none"
        value={email}
        onChangeText={setEmail}
      />

      <TextInput
        style={styles.input}
        placeholder="Idade"
        keyboardType="numeric"
        value={idade}
        onChangeText={setIdade}
      />

      <TouchableOpacity style={styles.botao} onPress={cadastrar}>
        <Text style={styles.textoBotao}>Cadastrar</Text>
      </TouchableOpacity>

      {mensagem !== '' && (
        <Text style={[styles.mensagem, { color: corMensagem }]}>
          {mensagem}
        </Text>
      )}
    </View>
  );
}

