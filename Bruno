import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
} from 'react-native';

export default function App() {
  const [peso, setPeso] = useState('');
  const [altura, setAltura] = useState('');
  const [resultado, setResultado] = useState('');
  const [cor, setCor] = useState('black');

  const calcularIMC = () => {
    if (peso === '' || altura === '') {
      setCor('red');
      setResultado('Preencha todos os campos.');
      return;
    }

    const pesoNum = parseFloat(peso);
    const alturaNum = parseFloat(altura);

    if (
      isNaN(pesoNum) ||
      isNaN(alturaNum) ||
      pesoNum <= 0 ||
      alturaNum <= 0
    ) {
      setCor('red');
      setResultado('Digite valores válidos.');
      return;
    }

    const imc = pesoNum / (alturaNum * alturaNum);

    let classificacao = '';

    if (imc < 18.5) {
      classificacao = 'Abaixo do peso';
      setCor('orange');
    } else if (imc < 25) {
      classificacao = 'Peso normal';
      setCor('green');
    } else if (imc < 30) {
      classificacao = 'Sobrepeso';
      setCor('orange');
    } else if (imc < 35) {
      classificacao = 'Obesidade Grau I';
      setCor('red');
    } else if (imc < 40) {
      classificacao = 'Obesidade Grau II';
      setCor('red');
    } else {
      classificacao = 'Obesidade Grau III';
      setCor('darkred');
    }

    setResultado(
      `Seu IMC é ${imc.toFixed(2)}\n\nClassificação: ${classificacao}`
    );
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Calculadora de IMC</Text>

      <TextInput
        style={styles.input}
        placeholder="Peso (kg)"
        keyboardType="numeric"
        value={peso}
        onChangeText={setPeso}
      />

      <TextInput
        style={styles.input}
        placeholder="Altura (m)"
        keyboardType="numeric"
        value={altura}
        onChangeText={setAltura}
      />

      <TouchableOpacity
        style={styles.botao}
        onPress={calcularIMC}
      >
        <Text style={styles.textoBotao}>Calcular IMC</Text>
      </TouchableOpacity>

      {resultado !== '' && (
        <Text style={[styles.resultado, { color: cor }]}>
          {resultado}
        </Text>
      )}
    </View>
  );
}

