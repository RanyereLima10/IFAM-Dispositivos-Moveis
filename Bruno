import React, { useState } from 'react';
import { View, Text, TextInput, Button, StyleSheet } from 'react-native';

export default function App() {
  const [saldo, setSaldo] = useState('');
  const [saque, setSaque] = useState('');
  const [resultado, setResultado] = useState('');

  const realizarSaque = () => {
    try {
      const saldoAtual = Number(saldo);
      const valorSaque = Number(saque);

      if (valorSaque > saldoAtual) {
        throw new Error('Saldo insuficiente.');
      }

      const novoSaldo = saldoAtual - valorSaque;
      setResultado(`Saque realizado! Novo saldo: R$ ${novoSaldo}`);
    } catch (erro) {
      setResultado(erro.message);
    } finally {
      console.log('Operação finalizada.');
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Saque Bancário</Text>

      <TextInput
        style={styles.input}
        placeholder="Digite o saldo"
        keyboardType="numeric"
        value={saldo}
        onChangeText={setSaldo}
      />

      <TextInput
        style={styles.input}
        placeholder="Digite o valor do saque"
        keyboardType="numeric"
        value={saque}
        onChangeText={setSaque}
      />

      <Button title="Sacar" onPress={realizarSaque} />

      <Text style={styles.resultado}>{resultado}</Text>
    </View>
  );
}

