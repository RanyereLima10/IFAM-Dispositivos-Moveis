  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>
        Escolha seu Plano de Internet
      </Text>

      <TouchableOpacity
        style={[
          styles.opcao,
          planoSelecionado === 'Basico' && styles.selecionado,
        ]}
        onPress={() => setPlanoSelecionado('Basico')}
      >
        <Text style={styles.textoOpcao}>
          Básico
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={[
          styles.opcao,
          planoSelecionado === 'Intermediario' && styles.selecionado,
        ]}
        onPress={() => setPlanoSelecionado('Intermediario')}
      >
        <Text style={styles.textoOpcao}>
          Intermediário
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={[
          styles.opcao,
          planoSelecionado === 'Premium' && styles.selecionado,
        ]}
        onPress={() => setPlanoSelecionado('Premium')}
      >
        <Text style={styles.textoOpcao}>
          Premium
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.botao}
        onPress={contratar}
      >
        <Text style={styles.textoBotao}>
          Contratar Plano
        </Text>
      </TouchableOpacity>

      {resultado !== '' && (
