import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
} from 'react-native';

export default function App() {
  const [nota1, setNota1] = useState('');
  const [nota2, setNota2] = useState('');
  const [nota3, setNota3] = useState('');
  const [resultado, setResultado] = useState('');
  const [cor, setCor] = useState('black');

  const calcularMedia = () => {
    if (nota1 === '' || nota2 === '' || nota3 === '') {
      setCor('red');
      setResultado('Preencha todas as notas.');
      return;
    }

    const n1 = Number(nota1);
    const n2 = Number(nota2);
    const n3 = Number(nota3);

    if (
      isNaN(n1) ||
      isNaN(n2) ||
      isNaN(n3) ||
      n1 < 0 ||
      n2 < 0 ||
      n3 < 0 ||
      n1 > 10 ||
      n2 > 10 ||
      n3 > 10
    ) {
      setCor('red');
      setResultado('Digite notas válidas entre 0 e 10.');
      return;
    }

    const media = (n1 + n2 + n3) / 3;

    let situacao = '';

    if (media >= 7) {
      situacao = 'Aprovado';
      setCor('green');
    } else if (media >= 5) {
      situacao = 'Recuperação';
      setCor('orange');
    } else {
      situacao = 'Reprovado';
      setCor('red');
    }

    setResultado(
      `Média: ${media.toFixed(2)}\n\nSituação: ${situacao}`
    );
  };

  const limpar = () => {
    setNota1('');
    setNota2('');
    setNota3('');
    setResultado('');
    setCor('black');
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>
        Controle Escolar
      </Text>

      <TextInput
        style={styles.input}
        placeholder="Nota 1"
        keyboardType="numeric"
        value={nota1}
        onChangeText={setNota1}
      />

      <TextInput
        style={styles.input}
        placeholder="Nota 2"
        keyboardType="numeric"
        value={nota2}
        onChangeText={setNota2}
      />

      <TextInput
        style={styles.input}
        placeholder="Nota 3"
        keyboardType="numeric"
        value={nota3}
        onChangeText={setNota3}
      />

      <TouchableOpacity
        style={styles.botao}
        onPress={calcularMedia}
      >
        <Text style={styles.textoBotao}>
          Calcular Média
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={[styles.botao, styles.botaoLimpar]}
        onPress={limpar}
      >
        <Text style={styles.textoBotao}>
          Limpar Campos
        </Text>
      </TouchableOpacity>

      {resultado !== '' && (
        <Text style={[styles.resultado, { color: cor }]}>
          {resultado}
        </Text>
      )}
    </View>
  );
}

