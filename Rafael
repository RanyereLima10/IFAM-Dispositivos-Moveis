import React, { useState } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet
} from 'react-native';

export default function App() {
  const [litros, setLitros] = useState('');
  const [resultado, setResultado] = useState('');

  function calcularConsumo() {
    const consumoDiario = Number(litros);

    // Verifica se o valor é válido
    if (litros === '' || isNaN(consumoDiario) || consumoDiario < 0) {
      setResultado('Digite uma quantidade válida de litros.');
      return;
    }

    // Calcula o consumo semanal
    const consumoSemanal = consumoDiario * 7;

    // Classifica o consumo
    let classificacao;

    if (consumoDiario < 100) {
      classificacao = 'Econômico';
    } else if (consumoDiario <= 200) {
      classificacao = 'Moderado';
    } else {
      classificacao = 'Elevado';
    }

    setResultado(
      `Consumo diário: ${consumoDiario} litros\n` +
      `Consumo semanal: ${consumoSemanal} litros\n` +
      `Classificação: ${classificacao}`
    );
  }

  return (
    <View style={styles.container}>

      <Text style={styles.titulo}>
        Controle de Consumo de Água
      </Text>

      <Text style={styles.label}>
        Litros consumidos por dia:
      </Text>

      <TextInput
        style={styles.input}
        placeholder="Ex: 80"
        keyboardType="numeric"
        value={litros}
        onChangeText={setLitros}
      />

      <TouchableOpacity
        style={styles.botao}
        onPress={calcularConsumo}
      >
        <Text style={styles.textoBotao}>
          Calcular Consumo
        </Text>
      </TouchableOpacity>

      {resultado !== '' && (
        <View style={styles.resultado}>
          <Text style={styles.textoResultado}>
            {resultado}
          </Text>
        </View>
      )}

    </View>
  );
}

