import React, { useEffect, useRef, useState } from 'react';

import {
  SafeAreaView,
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert,
  ActivityIndicator,
  Animated,
  Keyboard,
  Platform,
  ScrollView,
} from 'react-native';

// =====================================================
// CONFIGURAÇÃO
// =====================================================

// Depois substitua pela URL real do seu backend.
//
// Exemplo:
// const API_URL = 'http://192.168.1.10:3000/api/tips';

const API_URL = 'http://SEU_BACKEND_AQUI:3000/api/tips';

// =====================================================
// APP
// =====================================================

export default function App() {
  const [litrosPorDia, setLitrosPorDia] = useState('');
  const [semanal, setSemanal] = useState(null);
  const [classificacao, setClassificacao] = useState('');
  const [loadingTips, setLoadingTips] = useState(false);
  const [dicasIa, setDicasIa] = useState('');

  const fadeAnim = useRef(new Animated.Value(0)).current;
  const scaleAnim = useRef(new Animated.Value(0.8)).current;

  // =====================================================
  // ANIMAÇÃO
  // =====================================================

  useEffect(() => {
    if (semanal !== null) {
      fadeAnim.setValue(0);
      scaleAnim.setValue(0.8);

      Animated.parallel([
        Animated.timing(fadeAnim, {
          toValue: 1,
          duration: 500,
          useNativeDriver: true,
        }),
        Animated.spring(scaleAnim, {
          toValue: 1,
          friction: 7,
          tension: 50,
          useNativeDriver: true,
        }),
      ]).start();
    } else {
      fadeAnim.setValue(0);
      scaleAnim.setValue(0.8);
    }
  }, [semanal]);

  // =====================================================
  // CONVERTER TEXTO PARA NÚMERO
  // =====================================================

  function converterLitros(valor) {
    if (typeof valor !== 'string') {
      return NaN;
    }

    const numero = valor
      .replace(',', '.')
      .trim();

    return Number(numero);
  }

  // =====================================================
  // COR DA CLASSIFICAÇÃO
  // =====================================================

  function getClassificacaoCor(valor) {
    if (valor === 'Econômico') {
      return '#2ecc71';
    }

    if (valor === 'Moderado') {
      return '#f39c12';
    }

    if (valor === 'Elevado') {
      return '#e74c3c';
    }

    return '#95a5a6';
  }

  // =====================================================
  // CALCULAR
  // =====================================================

  function calcularConsumo() {
    Keyboard.dismiss();

    const litros = converterLitros(litrosPorDia);

    if (!Number.isFinite(litros) || litros <= 0) {
      Alert.alert(
        'Entrada inválida',
        'Digite uma quantidade válida de litros por dia.'
      );

      return;
    }

    const consumoSemanal = litros * 7;

    let novaClassificacao = '';

    if (consumoSemanal <= 350) {
      novaClassificacao = 'Econômico';
    } else if (consumoSemanal <= 1050) {
      novaClassificacao = 'Moderado';
    } else {
      novaClassificacao = 'Elevado';
    }

    setSemanal(consumoSemanal);
    setClassificacao(novaClassificacao);
    setDicasIa('');
  }

  // =====================================================
  // ADICIONAR 10 LITROS
  // =====================================================

  function adicionarDezLitros() {
    const atual = converterLitros(litrosPorDia);

    if (!Number.isFinite(atual)) {
      setLitrosPorDia('10');
      return;
    }

    setLitrosPorDia(String(atual + 10));
  }

  // =====================================================
  // LIMPAR
  // =====================================================

  function limpar() {
    Keyboard.dismiss();

    setLitrosPorDia('');
    setSemanal(null);
    setClassificacao('');
    setDicasIa('');
    setLoadingTips(false);
  }

  // =====================================================
  // DICAS DA IA
  // =====================================================

  async function obterDicasIa() {
    if (semanal === null || classificacao === '') {
      Alert.alert(
        'Calcule primeiro',
        'Calcule seu consumo semanal antes de solicitar dicas.'
      );

      return;
    }

    if (API_URL.includes('sua api')) {
      Alert.alert(
        'Backend não configurado',
        'Você precisa colocar o endereço do seu backend na constante API_URL.'
      );

      return;
    }

    setLoadingTips(true);
    setDicasIa('');

    try {
      const resposta = await fetch(API_URL, {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },

        body: JSON.stringify({
          weeklyLiters: semanal,
          classification: classificacao,
        }),
      });

      const texto = await resposta.text();

      let dados = null;

      try {
        dados = JSON.parse(texto);
      } catch (erroJson) {
        dados = null;
      }

      if (!resposta.ok) {
        const mensagem =
          dados && dados.message
            ? dados.message
            : dados && dados.error
              ? dados.error
              : 'Erro no servidor.';

        throw new Error(mensagem);
      }

      if (!dados || typeof dados.tips !== 'string') {
        throw new Error(
          'O servidor não retornou as dicas no formato esperado.'
        );
      }

      setDicasIa(dados.tips);
    } catch (erro) {
      console.log('Erro:', erro);

      Alert.alert(
        'Erro',
        'Não foi possível obter as dicas da IA.\n\n' +
          (erro && erro.message
            ? erro.message
            : 'Erro desconhecido.')
      );
    } finally {
      setLoadingTips(false);
    }
  }

  // =====================================================
  // INTERFACE
  // =====================================================

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView
        contentContainerStyle={styles.scrollContent}
        keyboardShouldPersistTaps="handled"
      >

        {/* CABEÇALHO */}

        <View style={styles.header}>
          <Text style={styles.waterIcon}>💧</Text>

          <Text style={styles.headerTitle}>
            Controle de Água
          </Text>

          <Text style={styles.headerSubtitle}>
            Registre seu consumo diário e receba dicas para
            economizar água.
          </Text>
        </View>

        {/* CONTEÚDO */}

        <View style={styles.container}>

          {/* CARD DE ENTRADA */}

          <View style={styles.card}>

            <Text style={styles.label}>
              Litros por dia
            </Text>

            <View style={styles.inputRow}>

              <TextInput
                style={styles.input}
                value={litrosPorDia}
                onChangeText={setLitrosPorDia}
                keyboardType={
                  Platform.OS === 'ios'
                    ? 'decimal-pad'
                    : 'numeric'
                }
                placeholder="Ex.: 120"
                placeholderTextColor="#999"
                returnKeyType="done"
                onSubmitEditing={calcularConsumo}
              />

              <TouchableOpacity
                style={styles.addButton}
                onPress={adicionarDezLitros}
                activeOpacity={0.8}
              >
                <Text style={styles.addButtonText}>
                  +
                </Text>
              </TouchableOpacity>

            </View>

            {/* CALCULAR */}

            <TouchableOpacity
              style={styles.primaryButton}
              onPress={calcularConsumo}
              activeOpacity={0.8}
            >
              <Text style={styles.primaryButtonText}>
                🧮 Calcular Consumo Semanal
              </Text>
            </TouchableOpacity>

            {/* LIMPAR */}

            <TouchableOpacity
              style={styles.clearButton}
              onPress={limpar}
              activeOpacity={0.7}
            >
              <Text style={styles.clearButtonText}>
                Limpar
              </Text>
            </TouchableOpacity>

          </View>

          {/* RESULTADO */}

          {semanal !== null && (
            <Animated.View
              style={[
                styles.resultCard,
                {
                  opacity: fadeAnim,
                  transform: [
                    {
                      scale: scaleAnim,
                    },
                  ],
                },
              ]}
            >

              <View style={styles.resultHeader}>

                <View style={styles.resultInfo}>

                  <Text style={styles.resultLabel}>
                    Consumo semanal
                  </Text>

                  <Text style={styles.resultDescription}>
                    Estimativa baseada no consumo diário.
                  </Text>

                </View>

                <Text style={styles.resultValue}>
                  {semanal.toFixed(1)} L
                </Text>

              </View>

              {/* CLASSIFICAÇÃO */}

              <View style={styles.classificationRow}>

                <View
                  style={[
                    styles.pill,
                    {
                      backgroundColor:
                        getClassificacaoCor(
                          classificacao
                        ),
                    },
                  ]}
                >
                  <Text style={styles.pillText}>
                    {classificacao}
                  </Text>
                </View>

                <View style={styles.spacer} />

                <TouchableOpacity
                  style={[
                    styles.tipsButton,
                    loadingTips && styles.disabledButton,
                  ]}
                  onPress={obterDicasIa}
                  disabled={loadingTips}
                  activeOpacity={0.8}
                >
                  <Text style={styles.tipsButtonText}>
                    {loadingTips
                      ? 'Carregando...'
                      : '💡 Dicas IA'}
                  </Text>
                </TouchableOpacity>

              </View>

              {/* CARREGANDO */}

              {loadingTips && (
                <View style={styles.loadingContainer}>

                  <ActivityIndicator
                    size="small"
                    color="#27ae60"
                  />

                  <Text style={styles.loadingText}>
                    Gerando dicas...
                  </Text>

                </View>
              )}

              {/* DICAS */}

              {dicasIa !== '' && !loadingTips && (
                <View style={styles.tipsBox}>

                  <Text style={styles.tipsTitle}>
                    💡 Dicas da IA
                  </Text>

                  <Text style={styles.tipsText}>
                    {dicasIa}
                  </Text>

                </View>
              )}

            </Animated.View>
          )}

        </View>

        {/* RODAPÉ */}

        <View style={styles.footer}>

          <Text style={styles.footerText}>
            Prefeitura • Incentive hábitos sustentáveis
          </Text>

          <Text style={styles.smallText}>
            {Platform.OS === 'android'
              ? 'Android'
              : 'iOS'}{' '}
            • Expo
          </Text>

        </View>

      </ScrollView>
    </SafeAreaView>
  );
}

