  return (
    <View style={styles.container}>

      <Text style={styles.titulo}>
        Escolha seu Plano de Internet
      </Text>

      <TouchableOpacity
        style={[
          styles.opcao,
          planoSelecionado === 'Basico' && styles.selecionado
        ]}
        onPress={() => selecionarPlano('Basico')}
      >
