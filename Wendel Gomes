  const [resultado, setResultado] = useState('');

  function calcularIMC() {
    const pesoNumero = Number(peso);
    const alturaNumero = Number(altura);

    // Verifica se os campos foram preenchidos
    if (peso === '' || altura === '') {
      Alert.alert(
        'Atenção',
        'Preencha o peso e a altura.'
      );
