        <Text style={styles.textoOpcao}>
          Intermediário
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={[
          styles.opcao,
          planoSelecionado === 'Premium' && styles.selecionado
        ]}
        onPress={() => selecionarPlano('Premium')}
      >
        <Text style={styles.textoOpcao}>
          Premium
        </Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.botao}
        onPress={contratar}
      >
        <Text style={styles.textoBotao}>
          Ver Plano
