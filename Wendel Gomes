  const planos = {
    Basico: {
      nome: 'Básico',
      valor: 'R$ 49,90',
      beneficios: '100 Mbps de internet e suporte online.'
    },

    Intermediario: {
      nome: 'Intermediário',
      valor: 'R$ 79,90',
      beneficios: '300 Mbps de internet, Wi-Fi grátis e suporte prioritário.'
