                </Text>
              ) : null}

              <Text style={styles.historicoData}>
                {formatarData(item.criado_em)}
              </Text>
            </View>
          ))
        )}

        <View style={styles.infoCard}>
          <Text style={styles.infoTitle}> EcoMonitor IA</Text>
          <Text style={styles.infoText}>
            Histórico salvo no celular com AsyncStorage (funciona no Snack).
          </Text>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

