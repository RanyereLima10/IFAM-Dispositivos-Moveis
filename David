  "cor": "#3F51B5",
  "descricao": "Explicação curta do que o consumo significa.",
  "dica": "Dica prática para economizar água."
}

Não coloque texto fora do JSON.
`;

    try {
      const resposta = await fetch(
        'https://openrouter.ai/api/v1/chat/completions',
        {
          method: 'POST',
          headers: {
